# .env.example → plantilla de variables de entorno.
# Copia este archivo como ".env" y ajusta los valores. El .env NUNCA se sube a GitHub.

# Puerto de la API
PORT=3000

# Base de datos de desarrollo (la que ves en MongoDB Compass)
MONGO_URI=mongodb://localhost:27017/devhub

# Base SOLO para pruebas e2e (se borra en cada ejecución)
MONGO_URI_TEST=mongodb://localhost:27017/devhub_test

# Secreto para firmar los tokens JWT (cámbialo por un texto largo y aleatorio)
JWT_SECRET=cambia-este-secreto-por-uno-largo

# URL del frontend Angular permitida por CORS
FRONTEND_URL=http://localhost:4200
